# รายการค่าตั้งค่าที่ API ต้องใช้ (ห้าม commit ไฟล์ .env ที่มีค่าจริง)
#
# ตอนรันด้วย docker compose ไม่ต้องสร้างไฟล์นี้ — ค่าถูกตั้งไว้ใน docker-compose.yml แล้ว
# ใช้ไฟล์นี้เป็นรายการอ้างอิงว่ามีค่าอะไรบ้าง หรือถ้าจะรัน API นอก Docker: cp .env.example .env แล้วแก้ค่า

NODE_ENV=development
PORT=3000

# ฐานข้อมูลบนเครื่อง (มาจาก docker-compose.yml ที่ root)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/maison_de_relic
# ตั้งเป็น true เฉพาะเมื่อต่อฐานข้อมูลภายนอกที่บังคับ SSL
DATABASE_SSL=false

# หน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย ,)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# (ไม่บังคับ) regex สำหรับ preview URL ของ Vercel เช่น ^https://maison-de-relic(-[a-z0-9-]+)?\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# ใช้โดยระบบ auth (R2) — บน production ต้องเป็นค่ายาวและสุ่ม
JWT_SECRET=change-me-in-production
# อายุของ token หลังล็อกอิน (ค่าเริ่มต้น 8h)
JWT_EXPIRES_IN=8h
