              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status = 200', () => pm.response.to.have.status(200));",
                  "pm.test('ทุกรายการมีคำว่า charizard', () => pm.response.json().data.forEach(p => pm.expect(p.title.toLowerCase()).to.include('charizard')));"
                ]
