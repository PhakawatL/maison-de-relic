        },
        {
          "name": "2.4 ค้นด้วยช่วงราคา + เรียงราคา (500–2000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/products?minPrice=500&maxPrice=2000&sort=price_asc",
              "host": [
                "{{base}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "minPrice",
                  "value": "500"
                },
                {
                  "key": "maxPrice",
                  "value": "2000"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status = 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('ราคาอยู่ในช่วง', () => d.forEach(p => { pm.expect(p.price).to.be.within(500, 2000); }));",
                  "pm.test('เรียงจากน้อยไปมาก', () => { for (let i = 1; i < d.length; i++) pm.expect(d[i].price).to.be.at.least(d[i-1].price); });"
                ]
              }
            }
          ]
        },
