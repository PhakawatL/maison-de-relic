    {
      "name": "3. Insert — สินค้า (POST /products)",
      "item": [
        {
          "name": "3.1 เพิ่มสินค้าตัวอย่างที่ 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_owner}}"
              }
            ],
            "url": {
              "raw": "{{base}}/products",
              "host": [
                "{{base}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"[Postman] Zaku II — ประกอบแล้ว\",\n  \"description\": \"ทดสอบเพิ่มสินค้าผ่าน Postman\",\n  \"category_id\": 3,\n  \"series_id\": 3,\n  \"status\": \"draft\",\n  \"condition\": \"like_new\",\n  \"price\": 1290,\n  \"stock_quantity\": 2,\n  \"attributes\": {\n    \"year\": \"2021\",\n    \"original_box\": \"yes\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status = 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json().data;",
                  "pm.test('ข้อมูลตรงกับที่ส่ง', () => { pm.expect(p.title).to.include('Zaku'); pm.expect(p.price).to.eql(1290); pm.expect(p.stock_quantity).to.eql(2); });",
                  "pm.collectionVariables.set('product_id_1', p.product_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 เพิ่มสินค้าตัวอย่างที่ 2 (staff เป็นคนเพิ่ม)",
