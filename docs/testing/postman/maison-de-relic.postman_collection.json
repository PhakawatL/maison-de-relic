    {
      "name": "4. Update — สินค้า (PUT /products/:id)",
      "item": [
        {
          "name": "4.1 แก้ไขสินค้าตัวอย่างที่ 1 (ราคา + สถานะ)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_owner}}"
              }
            ],
            "url": {
              "raw": "{{base}}/products/{{product_id_1}}",
              "host": [
