{
  "info": {
    "name": "Maison de Relic — Web Service Tests (ITDS242)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (POST /auth/login, GET /auth/me)",
      "item": [
        {
          "name": "1.1 Login owner (Neptz) สำเร็จ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Neptz\",\n  \"password\": \"Neptz@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status = 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('ได้ token และเป็น owner', () => { pm.expect(j.data.token).to.be.a('string'); pm.expect(j.data.user.admin_role).to.eql('owner'); });",
                  "pm.collectionVariables.set('token_owner', j.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login staff สำเร็จ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"staff\",\n  \"password\": \"Staff@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status = 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('เป็น staff', () => pm.expect(j.data.user.admin_role).to.eql('staff'));",
                  "pm.collectionVariables.set('token_staff', j.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login ลูกค้า (customer) สำเร็จ",
