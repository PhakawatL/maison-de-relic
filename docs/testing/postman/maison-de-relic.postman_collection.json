              "raw": "{{base}}/products",
              "host": [
                "{{base}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status = 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('มี meta.total และได้รายการ', () => { pm.expect(j.meta.total).to.be.above(0); pm.expect(j.data.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 ค้นด้วยชื่อ (q=charizard)",
          "request": {
            "method": "GET",
            "header": [],
